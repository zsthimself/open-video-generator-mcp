  "license": "MIT",
  "homepage": "https://openvideogenerator.com/settings/apikeys",
  "repository": {
    "type": "git",
    "url": "https://github.com/zsthimself/open-video-generator-mcp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
