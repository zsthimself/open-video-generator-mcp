{
  "name": "open-video-generator-mcp",
  "version": "1.0.0",
  "description": "Official MCP server and stdio bridge for OpenVideoGenerator — generate AI videos across Kling, MiniMax, Luma, and Hunyuan, poll render jobs, and search curated prompt blueprints.",
